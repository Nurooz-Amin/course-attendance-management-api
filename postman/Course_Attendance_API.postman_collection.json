      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Instructor Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"instructor\",\n  \"password\": \"InstructorPass123\"\n}"
            },
            "description": "Saves the JWT access and refresh tokens as collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.have.property('access');",
                  "pm.collectionVariables.set('access_token', data.access);",
                  "pm.collectionVariables.set('refresh_token', data.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me",
                ""
              ]
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                "refresh",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token refreshed', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('access_token', data.access);",
                  "if (data.refresh) pm.collectionVariables.set('refresh_token', data.refresh);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/courses/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "courses",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Courses returned', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const rows = body.results || body;",
                  "if (rows.length) pm.collectionVariables.set('course_id', rows[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Course as Instructor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/courses/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "courses",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"API-{{timestamp}}\",\n  \"title\": \"Advanced REST APIs\",\n  \"description\": \"Authentication, permissions, validation and testing.\",\n  \"is_active\": true\n}"
            },
            "description": "Creates a new course and saves its ID for the enrolment request."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('timestamp', Date.now().toString().slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Course created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('course_id', body.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Enrolments",
      "item": [
        {
          "name": "List Enrolments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/enrollments/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "enrollments",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Enrolments returned', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const rows = body.results || body;",
                  "if (rows.length) {",
                  "  pm.collectionVariables.set('enrollment_id', rows[0].id);",
                  "  pm.collectionVariables.set('student_id', rows[0].student.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Enrolment for New Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/enrollments/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "enrollments",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": \"{{course_id}}\",\n  \"student_id\": \"{{student_id}}\",\n  \"active\": true\n}"
            },
            "description": "Run List Enrolments first to capture a demo student ID, and Create Course first to capture a new course ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Enrolment created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('enrollment_id', body.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "List Attendance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/attendance/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "attendance",
                ""
              ]
            }
          }
        },
        {
          "name": "Mark Attendance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/attendance/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "attendance",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enrollment_id\": \"{{enrollment_id}}\",\n  \"date\": \"{{attendance_date}}\",\n  \"status\": \"present\",\n  \"remarks\": \"Completed the practical exercise.\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;",
                  "pm.collectionVariables.set('attendance_date', localDate);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Attendance created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate Attendance Validation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/attendance/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "attendance",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enrollment_id\": \"{{enrollment_id}}\",\n  \"date\": \"{{attendance_date}}\",\n  \"status\": \"absent\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const localDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;",
                  "pm.collectionVariables.set('attendance_date', localDate);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Duplicate is rejected', () => pm.response.to.have.status(400));",
                  "pm.expect(pm.response.text().toLowerCase()).to.include('already exists');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

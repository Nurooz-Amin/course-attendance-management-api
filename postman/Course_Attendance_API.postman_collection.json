{
  "info": {
    "_postman_id": "fa70df91-0f9c-4ace-a7fa-course-attendance",
    "name": "Course Attendance API",
    "description": "Complete Postman collection for the Course and Attendance Management REST API. Run seed_demo, then execute folders from top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
